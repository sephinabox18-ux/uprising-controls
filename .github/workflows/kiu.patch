+/**
+ * "KIU mode" v3 for Kid Icarus: Uprising. One job per control:
+ *  - Left: fixed joystick (placed in the layout editor) = Circle Pad, with a smooth ramp so
+ *    the game never mistakes a normal push for a dash.
+ *  - Right side: camera / aim trackpad driving an invisible stylus that stays pressed, so the
+ *    view holds when you lift your thumb. It re-centres itself at the edges for endless turning.
+ *  - FIRE: tap toggles continuous fire, hold fires while held.
+ *  - DASH: tap = dodge, hold = sprint, in the joystick direction.
+ *  - Small bottom screen in the left bar: tap to swap screens; its bottom strip = powers.
+ */
+class KiuController(private val overlay: InputOverlay) {
+
+    private enum class Show { ALWAYS, GAME, MENU }
+
+    private class KiuButton(
+        val id: String,
+        val label: String,
+        val action: Int,
+        val show: Show
+    ) {
+        var cx = 0f
+        var cy = 0f
+        var size = 0f // diameter in px
+        var pointerId = -1
+        var downTime = 0L
+        val pressed get() = pointerId != -1
+        fun contains(x: Float, y: Float, slop: Float): Boolean {
+            val dx = x - cx
+            val dy = y - cy
+            val r = size / 2f + slop
+            return dx * dx + dy * dy <= r * r
+        }
+    }
+
+    private val density = overlay.resources.displayMetrics.density
+    private fun dp(v: Float) = v * density
+
+    private val prefs get() = PreferenceManager.getDefaultSharedPreferences(CitraApplication.appContext)
+
+    // ---------------------------------------------------------------- options
+    private var fireTapToggles = prefs.getBoolean(PREF_FIRE_TOGGLE, true)
+    private var edgeWrap = prefs.getBoolean(PREF_EDGE_WRAP, true)
+    private var showAbInGame = prefs.getBoolean(PREF_SHOW_AB, false)
+    private var haptics = prefs.getBoolean(PREF_HAPTICS, true)
+    private var stickAlpha = prefs.getFloat(PREF_STICK_ALPHA, 0.6f)
+    private var buttonAlpha = prefs.getFloat(PREF_BUTTON_ALPHA, 0.8f)
+    private var camSens = prefs.getFloat(PREF_CAM_SENS, 1.0f)
+    private var camAccel = prefs.getFloat(PREF_CAM_ACCEL, 0.3f)
+    private var holdAimMs = prefs.getFloat(PREF_HOLD_AIM, 1.5f) * 1000f
+
+    // ---------------------------------------------------------------- geometry
+    private var viewW = 0
+    private var viewH = 0
+    private var laidOut = false
+    private var announced = false
+
+    /** false = game view (top screen big), true = bottom screen big */
+    private var bottomBig = false
+
+    private val bigRect = RectF()
+    private val miniRect = RectF()
+    private val gameRect = RectF()
+    private var miniW = 0f
+    private var miniH = 0f
+
+    private val stick = KiuButton("stick", "", ACTION_STICK, Show.GAME)
+    private val fireButton = KiuButton("fire", "FIRE", NativeLibrary.ButtonType.TRIGGER_L, Show.GAME)
+    private val buttons = listOf(
+        KiuButton("cog", "", ACTION_SETTINGS, Show.ALWAYS),
+        KiuButton("start", "START", NativeLibrary.ButtonType.BUTTON_START, Show.ALWAYS),
+        KiuButton("a", "A", NativeLibrary.ButtonType.BUTTON_A, Show.MENU),
+        KiuButton("b", "B", NativeLibrary.ButtonType.BUTTON_B, Show.MENU),
+        KiuButton("power", "POWER", NativeLibrary.ButtonType.DPAD_DOWN, Show.GAME),
+        KiuButton("dash", "DASH", ACTION_DASH, Show.GAME),
+        fireButton,
+        KiuButton("qs", "SAVE", ACTION_QUICKSAVE, Show.ALWAYS),
+        KiuButton("ql", "LOAD", ACTION_QUICKLOAD, Show.ALWAYS)
+    )
+
+    /** Everything the layout editor can move */
+    private val editables = buttons + stick
+
+    // ---------------------------------------------------------------- joystick state
+    private var stickId = -1
+    private var targetX = 0f // where the thumb is asking the stick to be (dead-zoned)
+    private var targetY = 0f
+    private var thumbX = 0f // raw thumb position, for drawing
+    private var thumbY = 0f
+    private var outX = 0f // what the game is actually getting
+    private var outY = 0f
+    private var lastDirX = 0f
+    private var lastDirY = -1f
+    private var lastTick = 0L
+    private val stickRadius get() = stick.size / 2f
+
+    // ---------------------------------------------------------------- dash state
+    private var dashActive = false
+    private var dashStart = 0L
+    private var dashReleased = false
+    private var dashIsTap = false
+    private var dashTapEnd = 0L
+
+    // ---------------------------------------------------------------- fire state
+    private var fireOn = false
+    private var fireWasOn = false
+    private var lSent = false
+
+    // ---------------------------------------------------------------- camera state
+    private var camId = -1
+    private var camLastX = 0f
+    private var camLastY = 0f
+    private var camLastT = 0L
+    private var lastCamMove = 0L
+    private var stylusDown = false
+    private var vx = 160f // virtual stylus, in 3DS touch-screen pixels
+    private var vy = 120f
+    private var wrapPhase = WRAP_NONE
+    private var wrapT = 0L
+    private var pendX = 0f
+    private var pendY = 0f
+
+    /** Touch going straight to the 3DS touch screen (power strip or big bottom screen) */
+    private var directId = -1
+
+    private var swapTapId = -1
+    private var swapTapX = 0f
+    private var swapTapY = 0f
+
+    // ---------------------------------------------------------------- layout editor
+    private var editMode = false
+    private var selected: KiuButton? = null
+    private var dragId = -1
+    private var dragOffX = 0f
+    private var dragOffY = 0f
+    private val toolMinus = RectF()
+    private val toolPlus = RectF()
+    private val toolReset = RectF()
+    private val toolDone = RectF()
+    private val grid get() = dp(16f)
+
+    // ---------------------------------------------------------------- frame ticker
+    private var ticking = false
+    private val frameCallback = Choreographer.FrameCallback {
+        ticking = false
+        tick()
+        if (needsTick()) scheduleTick()
+    }
+
+    // ---------------------------------------------------------------- paints
+    private val serif = Typeface.create(Typeface.SERIF, Typeface.BOLD)
+    private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
+    private val linePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE
+        strokeCap = Paint.Cap.ROUND
+        strokeJoin = Paint.Join.ROUND
+    }
+    private val textPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        textAlign = Paint.Align.CENTER
+        typeface = serif
+    }
+    private val iconPath = Path()
+
+    val isActive: Boolean
+        get() = laidOut && viewW > viewH && prefs.getBoolean(PREF_ENABLED, true)
+
+    // =================================================================== layout
+
+    fun onSizeChanged(width: Int, height: Int) {
+        viewW = width
+        viewH = height
+        if (width <= 0 || height <= 0 || width <= height) {
+            laidOut = false
+            return
+        }
+        laidOut = true
+        releaseAll()
+        if (EmulationMenuSettings.swapScreens) {
+            EmulationMenuSettings.swapScreens = false
+            NativeLibrary.swapScreens(false, overlay.display?.rotation ?: 0)
+        }
+        computeGeometry()
+        loadButtonLayout()
+        applyScreenLayout()
+        if (!announced) {
+            announced = true
+            toast("Uprising controls $KIU_VERSION")
+        }
+    }
+
+    private fun computeGeometry() {
+        val w = viewW.toFloat()
+        val h = viewH.toFloat()
+        val gw = min(w, h * 5f / 3f)
+        val gh = gw * 3f / 5f
+        gameRect.set((w - gw) / 2f, (h - gh) / 2f, (w + gw) / 2f, (h + gh) / 2f)
+        val pad = dp(6f)
+        miniW = max(gameRect.left - pad * 2f, dp(40f))
+        miniH = miniW * 0.75f
+    }
+
+    private fun applyScreenLayout() {
+        val w = viewW.toFloat()
+        val h = viewH.toFloat()
+        val pad = dp(6f)
+        if (!bottomBig) {
+            bigRect.set(gameRect)
+            miniRect.set(pad, pad, pad + miniW, pad + miniH)
+            writeLayout(top = bigRect, bottom = miniRect)
+        } else {
+            val bw = min(w, h * 4f / 3f)
+            val bh = bw * 0.75f
+            bigRect.set((w - bw) / 2f, (h - bh) / 2f, (w + bw) / 2f, (h + bh) / 2f)
+            var tw = miniH * 5f / 3f
+            var th = miniH
+            val maxW = bigRect.left - pad * 2f
+            if (tw > maxW) {
+                tw = max(maxW, dp(40f))
+                th = tw * 0.6f
+            }
+            miniRect.set(pad, pad, pad + tw, pad + th)
+            writeLayout(top = miniRect, bottom = bigRect)
+        }
+    }
+
+    private fun writeLayout(top: RectF, bottom: RectF) {
+        val settings: Settings = NativeLibrary.sEmulationActivity.get()?.settingsViewModel?.settings
+            ?: return
+        val values = listOf(
+            IntSetting.SCREEN_LAYOUT to LAYOUT_CUSTOM,
+            IntSetting.LANDSCAPE_TOP_X to top.left.roundToInt(),
+            IntSetting.LANDSCAPE_TOP_Y to top.top.roundToInt(),
+            IntSetting.LANDSCAPE_TOP_WIDTH to top.width().roundToInt(),
+            IntSetting.LANDSCAPE_TOP_HEIGHT to top.height().roundToInt(),
+            IntSetting.LANDSCAPE_BOTTOM_X to bottom.left.roundToInt(),
+            IntSetting.LANDSCAPE_BOTTOM_Y to bottom.top.roundToInt(),
+            IntSetting.LANDSCAPE_BOTTOM_WIDTH to bottom.width().roundToInt(),
+            IntSetting.LANDSCAPE_BOTTOM_HEIGHT to bottom.height().roundToInt()
+        )
+        for ((setting, value) in values) {
+            setting.int = value
+            settings.saveSetting(setting, SettingsFile.FILE_NAME_CONFIG)
+        }
+        if (BooleanSetting.SWAP_SCREEN.boolean) {
+            BooleanSetting.SWAP_SCREEN.boolean = false
+            settings.saveSetting(BooleanSetting.SWAP_SCREEN, SettingsFile.FILE_NAME_CONFIG)
+        }
+        NativeLibrary.reloadSettings()
+        NativeLibrary.updateFramebuffer(false)
+    }
+
+    private fun setDefaultLayout() {
+        val w = viewW.toFloat()
+        val h = viewH.toFloat()
+        val pad = dp(8f)
+        val stripL = gameRect.left
+        val rightX = gameRect.right
+        val stripR = w - rightX
+
+        fun set(b: KiuButton, cx: Float, cy: Float, size: Float) {
+            b.cx = cx
+            b.cy = cy
+            b.size = size
+        }
+        fun byId(id: String) = buttons.first { it.id == id }
+
+        // Right bar: [cog][start] / [A][B] ... POWER / DASH / FIRE
+        val small = min(dp(48f), (stripR - pad * 3f) / 2f)
+        val colA = rightX + pad + small / 2f
+        val colB = w - pad - small / 2f
+        val row1 = pad + small / 2f
+        val row2 = row1 + small + pad
+        set(byId("cog"), colA, row1, small * 0.85f)
+        set(byId("start"), colB, row1, small)
+        set(byId("a"), colB, row2, small)
+        set(byId("b"), colA, row2 + small * 0.55f, small)
+
+        val midX = rightX + stripR / 2f
+        val fire = min(dp(100f), stripR - pad * 2f)
+        val fireCy = h - pad - fire / 2f
+        set(fireButton, midX, fireCy, fire)
+        val dash = min(dp(72f), stripR - pad * 2f)
+        val dashCy = fireCy - fire / 2f - pad * 1.5f - dash / 2f
+        set(byId("dash"), midX, dashCy, dash)
+        val power = min(dp(56f), stripR - pad * 2f)
+        set(byId("power"), midX, dashCy - dash / 2f - pad * 1.5f - power / 2f, power)
+
+        // Left bar: small screen, quick save / load, joystick at the bottom
+        val q = min(dp(46f), (stripL - pad * 3f) / 2f)
+        val qy = pad + miniH + pad * 1.5f + q / 2f
+        val spare = (stripL - pad * 3f - q * 2f) / 4f
+        set(byId("qs"), pad + q / 2f + spare, qy, q)
+        set(byId("ql"), stripL - pad - q / 2f - spare, qy, q)
+
+        val s = min(dp(120f), stripL - pad * 2f)
+        set(stick, stripL / 2f, h - pad * 2f - s / 2f, s)
+    }
+
+    private fun loadButtonLayout() {
+        setDefaultLayout()
+        val h = viewH.toFloat()
+        val w = viewW.toFloat()
+        for (b in editables) {
+            val saved = prefs.getString(PREF_BTN_PREFIX + b.id, null) ?: continue
+            val parts = saved.split(",")
+            if (parts.size != 3) continue
+            val fx = parts[0].toFloatOrNull() ?: continue
+            val fy = parts[1].toFloatOrNull() ?: continue
+            val fs = parts[2].toFloatOrNull() ?: continue
+            b.cx = fx * w
+            b.cy = fy * h
+            b.size = fs * h
+        }
+    }
+
+    private fun saveButtonLayout() {
+        val e = prefs.edit()
+        for (b in editables) {
+            e.putString(PREF_BTN_PREFIX + b.id, "${b.cx / viewW},${b.cy / viewH},${b.size / viewH}")
+        }
+        e.apply()
+    }
+
+    private fun resetButtonLayout() {
+        val e = prefs.edit()
+        for (b in editables) e.remove(PREF_BTN_PREFIX + b.id)
+        e.apply()
+        setDefaultLayout()
+    }
+
+    private fun isVisible(b: KiuButton): Boolean = when (b.show) {
+        Show.ALWAYS -> true
+        Show.GAME -> !bottomBig
+        Show.MENU -> bottomBig || showAbInGame
+    }
+
+    // =================================================================== touch
+
+    fun onTouch(event: MotionEvent): Boolean {
+        if (editMode) {
+            onEditTouch(event)
+            overlay.invalidate()
+            return true
+        }
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN, MotionEvent.ACTION_POINTER_DOWN -> {
+                val i = event.actionIndex
+                onDown(event.getPointerId(i), event.getX(i), event.getY(i))
+            }
+
+            MotionEvent.ACTION_MOVE -> {
+                for (i in 0 until event.pointerCount) {
+                    onMove(event.getPointerId(i), event.getX(i), event.getY(i))
+                }
+            }
+
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_POINTER_UP -> {
+                val i = event.actionIndex
+                onUp(event.getPointerId(i), event.getX(i), event.getY(i))
+            }
+
+            MotionEvent.ACTION_CANCEL -> releaseAll()
+        }
+        scheduleTick()
+        overlay.invalidate()
+        return true
+    }
+
+    private fun onDown(id: Int, x: Float, y: Float) {
+        val slop = dp(4f)
+        for (b in buttons) {
+            if (isVisible(b) && b.pointerId == -1 && b.contains(x, y, slop)) {
+                pressButton(b, id)
+                return
+            }
+        }
+
+        if (miniRect.contains(x, y)) {
+            val powerStrip = !bottomBig && y > miniRect.bottom - miniRect.height() * POWER_STRIP
+            if (powerStrip) {
+                if (directId == -1) {
+                    directId = id
+                    stylusRelease()
+                    NativeLibrary.onTouchEvent(x, y, true)
+                }
+            } else if (swapTapId == -1) {
+                swapTapId = id
+                swapTapX = x
+                swapTapY = y
+            }
+            return
+        }
+
+        if (bottomBig) {
+            if (directId == -1 && bigRect.contains(x, y)) {
+                directId = id
+                NativeLibrary.onTouchEvent(x, y, true)
+            }
+            return
+        }
+
+        if (x < viewW / 2f) {
+            if (stickId == -1) {
+                stickId = id
+                updateStickTarget(x, y)
+            }
+        } else if (camId == -1) {
+            camId = id
+            camLastX = x
+            camLastY = y
+            camLastT = SystemClock.uptimeMillis()
+            lastCamMove = camLastT
+            if (!stylusDown && directId == -1 && wrapPhase == WRAP_NONE) {
+                if (edgeWrap && nearEdge(vx, vy)) {
+                    vx = 160f
+                    vy = 120f
+                }
+                stylusPress()
+            }
+        }
+    }
+
+    private fun onMove(id: Int, x: Float, y: Float) {
+        when (id) {
+            stickId -> updateStickTarget(x, y)
+            camId -> moveCamera(x, y)
+            directId -> NativeLibrary.onTouchMoved(x, y)
+        }
+    }
+
+    private fun onUp(id: Int, x: Float, y: Float) {
+        for (b in buttons) {
+            if (b.pointerId == id) {
+                releaseButton(b)
+                return
+            }
+        }
+        when (id) {
+            stickId -> {
+                stickId = -1
+                targetX = 0f
+                targetY = 0f
+            }
+
+            camId -> {
+                // The stylus stays pressed (still) for a moment, then lifts. Lifting while it is
+                // still moving would make the game spin the camera.
+                camId = -1
+                lastCamMove = SystemClock.uptimeMillis()
+            }
+
+            directId -> {
+                directId = -1
+                NativeLibrary.onTouchEvent(0f, 0f, false)
+            }
+
+            swapTapId -> {
+                swapTapId = -1
+                val moved = abs(x - swapTapX) + abs(y - swapTapY)
+                if (moved < dp(24f) && miniRect.contains(x, y)) toggleView()
+            }
+        }
+    }
+
+    // =================================================================== joystick
+
+    private fun updateStickTarget(x: Float, y: Float) {
+        thumbX = x
+        thumbY = y
+        val r = stickRadius
+        var nx = (x - stick.cx) / r
+        var ny = (y - stick.cy) / r
+        val len = sqrt(nx * nx + ny * ny)
+        if (len < STICK_DEADZONE) {
+            targetX = 0f
+            targetY = 0f
+            return
+        }
+        // Rescale so the stick starts moving right after the dead zone and tops out at the rim
+        val mag = min((len - STICK_DEADZONE) / (1f - STICK_DEADZONE), 1f)
+        nx /= len
+        ny /= len
+        targetX = nx * mag
+        targetY = ny * mag
+        if (mag > 0.25f) {
+            lastDirX = nx
+            lastDirY = ny
+        }
+    }
+
+    private fun tick() {
+        val now = SystemClock.uptimeMillis()
+        val dt = (now - lastTick).coerceIn(0L, 50L).toFloat()
+        lastTick = now
+
+        val wasDashing = dashActive
+        tickStick(now, dt)
+        tickCamera(now)
+        if (wasDashing != dashActive) overlay.invalidate()
+    }
+
+    private fun tickStick(now: Long, dt: Float) {
+        if (dashActive) {
+            val t = now - dashStart
+            when {
+                t < DASH_NEUTRAL_MS -> setStickOut(0f, 0f)
+                !dashReleased -> setStickOut(lastDirX, lastDirY)
+                dashIsTap && now < dashTapEnd -> setStickOut(lastDirX, lastDirY)
+                dashIsTap && now < dashTapEnd + DASH_NEUTRAL_MS -> setStickOut(0f, 0f)
+                else -> {
+                    dashActive = false
+                    setStickOut(0f, 0f)
+                }
+            }
+            return
+        }
+
+        // Smooth ramp outwards (the game reads a fast centre-to-edge push as a dash, so normal
+        // movement must never get there instantly). Easing back in is immediate.
+        val tMag = sqrt(targetX * targetX + targetY * targetY)
+        val oMag = sqrt(outX * outX + outY * outY)
+        if (tMag <= oMag || tMag < 0.001f) {
+            setStickOut(targetX, targetY)
+        } else {
+            val m = min(tMag, oMag + dt / STICK_RAMP_MS)
+            setStickOut(targetX / tMag * m, targetY / tMag * m)
+        }
+    }
+
+    private fun setStickOut(x: Float, y: Float) {
+        if (abs(x - outX) < 0.002f && abs(y - outY) < 0.002f) return
+        outX = x
+        outY = y
+        NativeLibrary.onGamePadMoveEvent(
+            NativeLibrary.TOUCHSCREEN_DEVICE,
+            NativeLibrary.ButtonType.STICK_LEFT,
+            x,
+            y
+        )
+    }
+
+    private fun startDash() {
+        dashActive = true
+        dashReleased = false
+        dashStart = SystemClock.uptimeMillis()
+    }
+
+    private fun releaseDash(held: Long) {
+        if (!dashActive) return
+        dashReleased = true
+        dashIsTap = held < DASH_TAP_MS
+        dashTapEnd = max(SystemClock.uptimeMillis(), dashStart + DASH_NEUTRAL_MS + DASH_DODGE_MS)
+    }
+
+    // =================================================================== camera
+
+    private fun nearEdge(x: Float, y: Float): Boolean =
+        x < EDGE_MARGIN || x > 320f - EDGE_MARGIN || y < EDGE_MARGIN || y > 240f - EDGE_MARGIN
+
+    private fun moveCamera(x: Float, y: Float) {
+        val now = SystemClock.uptimeMillis()
+        val dx = x - camLastX
+        val dy = y - camLastY
+        val dt = max(1L, now - camLastT).toFloat()
+        camLastX = x
+        camLastY = y
+        camLastT = now
+        if (dx == 0f && dy == 0f) return
+        lastCamMove = now
+
+        // Whole right half of the phone = one full width of the 3DS touch screen at 100%
+        val base = 320f / (viewW / 2f)
+        val speed = sqrt(dx * dx + dy * dy) / dt // phone px per ms
+        val gain = base * camSens * (1f + camAccel * min(speed / 3f, 1f))
+        val mx = dx * gain
+        val my = dy * gain
+
+        if (directId != -1) return
+        if (wrapPhase != WRAP_NONE) {
+            pendX += mx
+            pendY += my
+            return
+        }
+
+        vx += mx
+        vy += my
+        if (edgeWrap) {
+            if (nearEdge(vx, vy)) {
+                // Hold still, lift, and come back down in the centre, carrying the overflow
+                pendX = vx - vx.coerceIn(EDGE_MARGIN, 320f - EDGE_MARGIN)
+                pendY = vy - vy.coerceIn(EDGE_MARGIN, 240f - EDGE_MARGIN)
+                vx = vx.coerceIn(EDGE_MARGIN, 320f - EDGE_MARGIN)
+                vy = vy.coerceIn(EDGE_MARGIN, 240f - EDGE_MARGIN)
+                wrapPhase = WRAP_FREEZE
+                wrapT = now
+            }
+        } else {
+            vx = vx.coerceIn(1f, 319f)
+            vy = vy.coerceIn(1f, 239f)
+        }
+        if (stylusDown) stylusMove() else stylusPress()
+    }
+
+    private fun tickCamera(now: Long) {
+        when (wrapPhase) {
+            WRAP_FREEZE -> if (now - wrapT >= WRAP_FREEZE_MS) {
+                if (stylusDown) {
+                    NativeLibrary.onTouchEvent(0f, 0f, false)
+                    stylusDown = false
+                }
+                wrapPhase = WRAP_LIFTED
+                wrapT = now
+            }
+
+            WRAP_LIFTED -> if (now - wrapT >= WRAP_LIFT_MS) {
+                vx = (160f + pendX).coerceIn(EDGE_MARGIN + 1f, 320f - EDGE_MARGIN - 1f)
+                vy = (120f + pendY).coerceIn(EDGE_MARGIN + 1f, 240f - EDGE_MARGIN - 1f)
+                pendX = 0f
+                pendY = 0f
+                wrapPhase = WRAP_NONE
+                if (directId == -1 && !bottomBig) stylusPress()
+                lastCamMove = now
+            }
+        }
+
+        if (camId == -1 && stylusDown && wrapPhase == WRAP_NONE) {
+            val hold = max(holdAimMs, MIN_STILL_MS.toFloat())
+            if (now - lastCamMove >= hold) stylusRelease()
+        }
+    }
+
+    private fun stylusToFramebuffer(): Pair<Float, Float> {
+        val fx = miniRect.left + (vx.coerceIn(0.5f, 319.5f) / 320f) * miniRect.width()
+        val fy = miniRect.top + (vy.coerceIn(0.5f, 239.5f) / 240f) * miniRect.height()
+        return Pair(fx, fy)
+    }
+
+    private fun stylusPress() {
+        if (bottomBig || directId != -1) return
+        val (fx, fy) = stylusToFramebuffer()
+        NativeLibrary.onTouchEvent(fx, fy, true)
+        stylusDown = true
+    }
+
+    private fun stylusMove() {
+        val (fx, fy) = stylusToFramebuffer()
+        NativeLibrary.onTouchMoved(fx, fy)
+    }
+
+    private fun stylusRelease() {
+        if (stylusDown) {
+            NativeLibrary.onTouchEvent(0f, 0f, false)
+            stylusDown = false
+        }
+        wrapPhase = WRAP_NONE
+        pendX = 0f
+        pendY = 0f
+    }
+
+    // =================================================================== buttons
+
+    private fun updateL() {
+        val want = fireOn || fireButton.pressed
+        if (want != lSent) {
+            lSent = want
+            sendButton(NativeLibrary.ButtonType.TRIGGER_L, want)
+        }
+    }
+
+    private fun stopFiring() {
+        fireOn = false
+        updateL()
+    }
+
+    private fun sendButton(button: Int, press: Boolean) {
+        NativeLibrary.onGamePadEvent(
+            NativeLibrary.TOUCHSCREEN_DEVICE,
+            button,
+            if (press) NativeLibrary.ButtonState.PRESSED else NativeLibrary.ButtonState.RELEASED
+        )
+    }
+
+    private fun buzz() {
+        if (haptics) overlay.performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY)
+    }
+
+    private fun toast(text: String) {
+        Toast.makeText(CitraApplication.appContext, text, Toast.LENGTH_SHORT).show()
+    }
+
+    private fun pressButton(b: KiuButton, id: Int) {
+        b.pointerId = id
+        b.downTime = SystemClock.uptimeMillis()
+        buzz()
+        when (b.action) {
+            ACTION_SETTINGS, ACTION_QUICKLOAD -> {}
+            ACTION_QUICKSAVE -> {
+                NativeLibrary.saveState(NativeLibrary.QUICKSAVE_SLOT)
+                toast("Quick saved")
+            }
+
+            ACTION_DASH -> startDash()
+            NativeLibrary.ButtonType.TRIGGER_L -> {
+                fireWasOn = fireOn
+                updateL()
+            }
+
+            NativeLibrary.ButtonType.BUTTON_START -> {
+                stopFiring()
+                stylusRelease()
+                sendButton(b.action, true)
+            }
+
+            else -> sendButton(b.action, true)
+        }
+    }
+
+    private fun releaseButton(b: KiuButton) {
+        b.pointerId = -1
+        val held = SystemClock.uptimeMillis() - b.downTime
+        when (b.action) {
+            ACTION_QUICKSAVE -> {}
+            ACTION_SETTINGS -> openSettings()
+            ACTION_QUICKLOAD -> {
+                if (held >= QUICKLOAD_HOLD_MS) {
+                    val loaded = NativeLibrary.loadStateIfAvailable(NativeLibrary.QUICKSAVE_SLOT)
+                    toast(if (loaded) "Quick loaded" else "No quick save yet")
+                } else {
+                    toast("Hold LOAD to load your quick save")
+                }
+            }
+
+            ACTION_DASH -> releaseDash(held)
+            NativeLibrary.ButtonType.TRIGGER_L -> {
+                // Quick tap flips continuous fire; a longer hold just fired while held
+                fireOn = if (fireTapToggles && held < FIRE_TAP_MS) !fireWasOn else fireWasOn
+                updateL()
+            }
+
+            else -> sendButton(b.action, false)
+        }
+    }
+
+    private fun toggleView() {
+        releaseAll()
+        bottomBig = !bottomBig
+        buzz()
+        applyScreenLayout()
+    }
+
+    private fun releaseAll() {
+        for (b in buttons) {
+            if (b.pressed) {
+                b.pointerId = -1
+                if (b.action >= 0 && b.action != NativeLibrary.ButtonType.TRIGGER_L) {
+                    sendButton(b.action, false)
+                }
+            }
+        }
+        fireOn = false
+        updateL()
+        stickId = -1
+        targetX = 0f
+        targetY = 0f
+        dashActive = false
+        setStickOut(0f, 0f)
+        camId = -1
+        stylusRelease()
+        if (directId != -1) {
+            NativeLibrary.onTouchEvent(0f, 0f, false)
+            directId = -1
+        }
+        swapTapId = -1
+    }
+
+    // =================================================================== frame ticker
+
+    private fun needsTick(): Boolean =
+        stickId != -1 || dashActive || stylusDown || wrapPhase != WRAP_NONE ||
+            abs(outX) > 0.001f || abs(outY) > 0.001f
+
+    private fun scheduleTick() {
+        if (!ticking && needsTick()) {
+            ticking = true
+            if (lastTick == 0L || SystemClock.uptimeMillis() - lastTick > 100L) {
+                lastTick = SystemClock.uptimeMillis()
+            }
+            Choreographer.getInstance().postFrameCallback(frameCallback)
+        }
+    }
+
+    // =================================================================== settings
+
+    private fun openSettings() {
+        releaseAll()
+        val ctx: Context = overlay.context
+        NativeLibrary.pauseEmulation()
+
+        val pad = dp(20f).toInt()
+        val column = LinearLayout(ctx).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(pad, pad / 2, pad, 0)
+        }
+
+        fun note(text: String) {
+            column.addView(TextView(ctx).apply {
+                this.text = text
+                alpha = 0.7f
+                textSize = 12f
+                setPadding(0, 0, 0, pad / 2)
+            })
+        }
+
+        fun toggle(title: String, value: Boolean, onChange: (Boolean) -> Unit) {
+            column.addView(MaterialSwitch(ctx).apply {
+                text = title
+                isChecked = value
+                setOnCheckedChangeListener { _, checked -> onChange(checked) }
+            })
+        }
+
+        fun slider(
+            title: String,
+            from: Float,
+            to: Float,
+            step: Float,
+            value: Float,
+            onChange: (Float) -> Unit
+        ) {
+            column.addView(TextView(ctx).apply {
+                text = title
+                setPadding(0, pad / 2, 0, 0)
+            })
+            val steps = ((value - from) / step).roundToInt()
+            val snapped = (from + steps * step).coerceIn(from, to)
+            column.addView(Slider(ctx).apply {
+                valueFrom = from
+                valueTo = to
+                stepSize = step
+                this.value = snapped
+                addOnChangeListener { _, v, _ -> onChange(v) }
+            })
+        }
+
+        toggle("Tap FIRE to toggle firing", fireTapToggles) {
+            fireTapToggles = it
+            prefs.edit().putBoolean(PREF_FIRE_TOGGLE, it).apply()
+        }
+        note("On: a quick tap turns continuous fire on or off, holding fires while held. Off: FIRE only fires while held.")
+
+        toggle("Endless camera turning", edgeWrap) {
+            edgeWrap = it
+            prefs.edit().putBoolean(PREF_EDGE_WRAP, it).apply()
+        }
+        note("Re-centres the hidden stylus at the edges so you can keep turning. Turn off if aiming in the air battles feels jumpy at the screen edges.")
+
+        slider("Camera sensitivity (%)", 20f, 300f, 10f, camSens * 100f) {
+            camSens = it / 100f
+            prefs.edit().putFloat(PREF_CAM_SENS, camSens).apply()
+        }
+        slider("Camera acceleration (%)", 0f, 100f, 10f, camAccel * 100f) {
+            camAccel = it / 100f
+            prefs.edit().putFloat(PREF_CAM_ACCEL, camAccel).apply()
+        }
+        note("Higher = fast swipes turn further, slow swipes stay precise.")
+        slider("Keep aim after lifting thumb (seconds)", 0f, 4f, 0.25f, holdAimMs / 1000f) {
+            holdAimMs = it * 1000f
+            prefs.edit().putFloat(PREF_HOLD_AIM, it).apply()
+        }
+
+        slider("Joystick visibility (0 = invisible)", 0f, 100f, 5f, stickAlpha * 100f) {
+            stickAlpha = it / 100f
+            prefs.edit().putFloat(PREF_STICK_ALPHA, stickAlpha).apply()
+        }
+        slider("Button visibility", 10f, 100f, 5f, buttonAlpha * 100f) {
+            buttonAlpha = it / 100f
+            prefs.edit().putFloat(PREF_BUTTON_ALPHA, buttonAlpha).apply()
+        }
+
+        toggle("Show A / B during battles", showAbInGame) {
+            showAbInGame = it
+            prefs.edit().putBoolean(PREF_SHOW_AB, it).apply()
+        }
+        toggle("Vibration", haptics) {
+            haptics = it
+            prefs.edit().putBoolean(PREF_HAPTICS, it).apply()
+        }
+
+        val scroll = ScrollView(ctx).apply { addView(column) }
+        var startEditing = false
+        MaterialAlertDialogBuilder(ctx)
+            .setTitle("Uprising controls $KIU_VERSION")
+            .setView(scroll)
+            .setPositiveButton("Done", null)
+            .setNeutralButton("Edit layout") { _, _ -> startEditing = true }
+            .setOnDismissListener {
+                if (startEditing) {
+                    editMode = true
+                    selected = null
+                } else {
+                    NativeLibrary.unPauseEmulation()
+                }
+                overlay.invalidate()
+            }
+            .show()
+    }
+
+    // =================================================================== layout editor
+
+    private fun snap(v: Float): Float = (v / grid).roundToInt() * grid
+
+    private fun onEditTouch(event: MotionEvent) {
+        val i = event.actionIndex
+        val id = event.getPointerId(i)
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN, MotionEvent.ACTION_POINTER_DOWN -> {
+                val x = event.getX(i)
+                val y = event.getY(i)
+                val sel = selected
+                when {
+                    toolDone.contains(x, y) -> {
+                        editMode = false
+                        selected = null
+                        saveButtonLayout()
+                        NativeLibrary.unPauseEmulation()
+                    }
+
+                    toolReset.contains(x, y) -> {
+                        resetButtonLayout()
+                        selected = null
+                    }
+
+                    toolMinus.contains(x, y) && sel != null -> resizeSelected(-dp(4f))
+                    toolPlus.contains(x, y) && sel != null -> resizeSelected(dp(4f))
+                    else -> {
+                        val hit = editables.lastOrNull { it.contains(x, y, dp(4f)) }
+                        selected = hit
+                        if (hit != null && dragId == -1) {
+                            dragId = id
+                            dragOffX = x - hit.cx
+                            dragOffY = y - hit.cy
+                        }
+                    }
+                }
+            }
+
+            MotionEvent.ACTION_MOVE -> {
+                val sel = selected ?: return
+                val idx = event.findPointerIndex(dragId)
+                if (idx < 0) return
+                val r = sel.size / 2f
+                sel.cx = snap(event.getX(idx) - dragOffX).coerceIn(r, viewW - r)
+                sel.cy = snap(event.getY(idx) - dragOffY).coerceIn(r, viewH - r)
+            }
+
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_POINTER_UP -> {
+                if (id == dragId) dragId = -1
+            }
+
+            MotionEvent.ACTION_CANCEL -> dragId = -1
+        }
+    }
+
+    private fun resizeSelected(delta: Float) {
+        val sel = selected ?: return
+        val maxSize = if (sel === stick) dp(260f) else dp(160f)
+        sel.size = (sel.size + delta * (if (sel === stick) 2f else 1f)).coerceIn(dp(32f), maxSize)
+    }
+
+    // =================================================================== drawing
+
+    private fun withAlpha(color: Int, a: Float): Int = Color.argb(
+        (Color.alpha(color) * a).toInt().coerceIn(0, 255),
+        Color.red(color),
+        Color.green(color),
+        Color.blue(color)
+    )
+
+    fun draw(canvas: Canvas) {
+        if (editMode) {
+            drawEditor(canvas)
+            return
+        }
+
+        drawMiniFrame(canvas)
+        for (b in buttons) {
+            if (isVisible(b)) drawButton(canvas, b, buttonAlpha)
+        }
+        if (!bottomBig) drawStick(canvas, stickAlpha)
+    }
+
+    private fun drawStick(canvas: Canvas, alpha: Float) {
+        if (alpha <= 0f) return
+        val r = stickRadius
+        val cx = stick.cx
+        val cy = stick.cy
+        fillPaint.color = withAlpha(NAVY_SOFT, alpha)
+        canvas.drawCircle(cx, cy, r, fillPaint)
+        linePaint.strokeWidth = dp(2.5f)
+        linePaint.color = withAlpha(GOLD, alpha)
+        canvas.drawCircle(cx, cy, r, linePaint)
+        linePaint.strokeWidth = dp(1f)
+        canvas.drawCircle(cx, cy, r - dp(5f), linePaint)
+
+        // Knob follows the thumb (clamped to the rim) so it always feels attached
+        var kx = 0f
+        var ky = 0f
+        if (stickId != -1) {
+            kx = (thumbX - cx) / r
+            ky = (thumbY - cy) / r
+            val len = sqrt(kx * kx + ky * ky)
+            if (len > 1f) {
+                kx /= len
+                ky /= len
+            }
+        }
+        val px = cx + kx * r
+        val py = cy + ky * r
+        fillPaint.color = withAlpha(IVORY, alpha)
+        canvas.drawCircle(px, py, r * 0.42f, fillPaint)
+        linePaint.strokeWidth = dp(2f)
+        canvas.drawCircle(px, py, r * 0.42f, linePaint)
+        fillPaint.color = withAlpha(if (dashActive) SKY else NAVY, alpha)
+        canvas.drawCircle(px, py, r * 0.16f, fillPaint)
+    }
+
+    private fun drawMiniFrame(canvas: Canvas) {
+        val r = dp(4f)
+        linePaint.color = GOLD
+        linePaint.strokeWidth = dp(2f)
+        canvas.drawRoundRect(miniRect, r, r, linePaint)
+        if (!bottomBig) {
+            val y = miniRect.bottom - miniRect.height() * POWER_STRIP
+            linePaint.strokeWidth = dp(1f)
+            linePaint.color = withAlpha(GOLD, 0.5f)
+            canvas.drawLine(miniRect.left + r, y, miniRect.right - r, y, linePaint)
+        }
+    }
+
+    private fun drawButton(canvas: Canvas, b: KiuButton, alpha: Float, highlight: Boolean = false) {
+        val r = b.size / 2f
+        val lit = b.pressed || (b === fireButton && fireOn) || (b.action == ACTION_DASH && dashActive)
+        fillPaint.color = withAlpha(if (lit) SKY else NAVY, alpha)
+        canvas.drawCircle(b.cx, b.cy, r, fillPaint)
+        linePaint.color = withAlpha(if (highlight) SKY_LIGHT else GOLD, alpha)
+        linePaint.strokeWidth = if (highlight) dp(4f) else dp(2.5f)
+        canvas.drawCircle(b.cx, b.cy, r - dp(1f), linePaint)
+        linePaint.strokeWidth = dp(1f)
+        linePaint.color = withAlpha(GOLD, alpha * 0.6f)
+        canvas.drawCircle(b.cx, b.cy, r - dp(5f), linePaint)
+        if (b === fireButton && fireOn) {
+            // Continuous fire indicator: a bright outer halo
+            linePaint.strokeWidth = dp(3f)
+            linePaint.color = withAlpha(SKY_LIGHT, alpha)
+            canvas.drawCircle(b.cx, b.cy, r + dp(4f), linePaint)
+        }
+
+        val ink = withAlpha(IVORY, alpha)
+        when (b.action) {
+            ACTION_SETTINGS -> drawCog(canvas, b.cx, b.cy, r * 0.5f, ink)
+            NativeLibrary.ButtonType.TRIGGER_L -> {
+                drawArrow(canvas, b.cx, b.cy - r * 0.12f, r * 0.5f, ink)
+                drawLabel(canvas, if (fireOn) "AUTO" else b.label, b.cx, b.cy + r * 0.48f, r * 0.26f, ink)
+            }
+
+            ACTION_DASH -> {
+                drawWing(canvas, b.cx, b.cy - r * 0.1f, r * 0.5f, ink)
+                drawLabel(canvas, b.label, b.cx, b.cy + r * 0.5f, r * 0.26f, ink)
+            }
+
+            NativeLibrary.ButtonType.DPAD_DOWN -> {
+                drawBolt(canvas, b.cx, b.cy - r * 0.12f, r * 0.42f, ink)
+                drawLabel(canvas, b.label, b.cx, b.cy + r * 0.5f, r * 0.24f, ink)
+            }
+
+            ACTION_QUICKSAVE, ACTION_QUICKLOAD, NativeLibrary.ButtonType.BUTTON_START ->
+                drawLabel(canvas, b.label, b.cx, b.cy, r * 0.34f, ink)
+
+            else -> drawLabel(canvas, b.label, b.cx, b.cy, r * 0.62f, ink)
+        }
+    }
+
+    private fun drawLabel(canvas: Canvas, text: String, cx: Float, cy: Float, size: Float, color: Int) {
+        textPaint.textSize = size
+        textPaint.color = color
+        canvas.drawText(text, cx, cy - (textPaint.descent() + textPaint.ascent()) / 2f, textPaint)
+    }
+
+    private fun drawArrow(canvas: Canvas, cx: Float, cy: Float, s: Float, color: Int) {
+        linePaint.color = color
+        linePaint.strokeWidth = s * 0.16f
+        canvas.drawLine(cx - s * 0.7f, cy + s * 0.7f, cx + s * 0.6f, cy - s * 0.6f, linePaint)
+        iconPath.reset()
+        iconPath.moveTo(cx + s * 0.85f, cy - s * 0.85f)
+        iconPath.lineTo(cx + s * 0.25f, cy - s * 0.55f)
+        iconPath.lineTo(cx + s * 0.55f, cy - s * 0.25f)
+        iconPath.close()
+        fillPaint.color = color
+        canvas.drawPath(iconPath, fillPaint)
+        canvas.drawLine(cx - s * 0.7f, cy + s * 0.7f, cx - s * 0.75f, cy + s * 0.3f, linePaint)
+        canvas.drawLine(cx - s * 0.7f, cy + s * 0.7f, cx - s * 0.3f, cy + s * 0.75f, linePaint)
+    }
+
+    /** A small wing: three swept feathers */
+    private fun drawWing(canvas: Canvas, cx: Float, cy: Float, s: Float, color: Int) {
+        linePaint.color = color
+        linePaint.strokeWidth = s * 0.17f
+        for (k in 0 until 3) {
+            val off = k * s * 0.32f
+            canvas.drawLine(cx - s * 0.8f, cy + s * 0.35f - off * 0.3f, cx + s * 0.75f - off, cy - s * 0.55f + off, linePaint)
+        }
+    }
+
+    private fun drawBolt(canvas: Canvas, cx: Float, cy: Float, s: Float, color: Int) {
+        iconPath.reset()
+        iconPath.moveTo(cx + s * 0.15f, cy - s)
+        iconPath.lineTo(cx - s * 0.55f, cy + s * 0.15f)
+        iconPath.lineTo(cx - s * 0.05f, cy + s * 0.15f)
+        iconPath.lineTo(cx - s * 0.2f, cy + s)
+        iconPath.lineTo(cx + s * 0.55f, cy - s * 0.2f)
+        iconPath.lineTo(cx + s * 0.05f, cy - s * 0.2f)
+        iconPath.close()
+        fillPaint.color = color
+        canvas.drawPath(iconPath, fillPaint)
+    }
+
+    private fun drawCog(canvas: Canvas, cx: Float, cy: Float, s: Float, color: Int) {
+        linePaint.color = color
+        linePaint.strokeWidth = s * 0.3f
+        canvas.drawCircle(cx, cy, s * 0.55f, linePaint)
+        linePaint.strokeWidth = s * 0.28f
+        for (k in 0 until 8) {
+            val a = Math.toRadians(k * 45.0)
+            val c = Math.cos(a).toFloat()
+            val sn = Math.sin(a).toFloat()
+            canvas.drawLine(cx + c * s * 0.7f, cy + sn * s * 0.7f, cx + c * s, cy + sn * s, linePaint)
+        }
+    }
+
+    private fun drawEditor(canvas: Canvas) {
+        canvas.drawColor(Color.argb(110, 0, 0, 0))
+
+        linePaint.strokeWidth = dp(0.75f)
+        linePaint.color = withAlpha(GOLD, 0.18f)
+        var gx = 0f
+        while (gx <= viewW) {
+            canvas.drawLine(gx, 0f, gx, viewH.toFloat(), linePaint)
+            gx += grid
+        }
+        var gy = 0f
+        while (gy <= viewH) {
+            canvas.drawLine(0f, gy, viewW.toFloat(), gy, linePaint)
+            gy += grid
+        }
+
+        drawMiniFrame(canvas)
+        drawStick(canvas, 1f)
+        if (selected === stick) {
+            linePaint.strokeWidth = dp(4f)
+            linePaint.color = SKY_LIGHT
+            canvas.drawCircle(stick.cx, stick.cy, stickRadius + dp(3f), linePaint)
+        }
+        for (b in buttons) drawButton(canvas, b, 1f, highlight = b === selected)
+
+        val bw = dp(76f)
+        val bh = dp(40f)
+        val gap = dp(10f)
+        val total = bw * 4 + gap * 3
+        var x = (viewW - total) / 2f
+        val y = gameRect.top + dp(10f)
+        for ((rect, label) in listOf(
+            toolMinus to "−",
+            toolPlus to "+",
+            toolReset to "RESET",
+            toolDone to "DONE"
+        )) {
+            rect.set(x, y, x + bw, y + bh)
+            val enabled = selected != null || rect === toolReset || rect === toolDone
+            fillPaint.color = if (rect === toolDone) SKY else NAVY
+            canvas.drawRoundRect(rect, bh / 2f, bh / 2f, fillPaint)
+            linePaint.strokeWidth = dp(2f)
+            linePaint.color = GOLD
+            canvas.drawRoundRect(rect, bh / 2f, bh / 2f, linePaint)
+            drawLabel(canvas, label, rect.centerX(), rect.centerY(), dp(16f), withAlpha(IVORY, if (enabled) 1f else 0.35f))
+            x += bw + gap
+        }
+        drawLabel(
+            canvas,
+            if (selected == null) "Tap a button or the joystick to select it, drag to move" else "Drag to move · − / + to resize",
+            viewW / 2f,
+            y + bh + dp(22f),
+            dp(13f),
+            IVORY
+        )
+    }
+
+    companion object {
+        const val KIU_VERSION = "v3"
+        private const val ACTION_SETTINGS = -1001
+        private const val ACTION_QUICKSAVE = -1003
+        private const val ACTION_QUICKLOAD = -1004
+        private const val ACTION_DASH = -1005
+        private const val ACTION_STICK = -1006
+        private const val LAYOUT_CUSTOM = 5
+        private const val POWER_STRIP = 0.3f
+
+        private const val STICK_DEADZONE = 0.1f
+        private const val STICK_RAMP_MS = 90f // centre to full push, normal movement
+        private const val DASH_NEUTRAL_MS = 50L
+        private const val DASH_DODGE_MS = 130L
+        private const val DASH_TAP_MS = 220L
+        private const val FIRE_TAP_MS = 250L
+        private const val QUICKLOAD_HOLD_MS = 500L
+
+        private const val EDGE_MARGIN = 28f // 3DS pixels
+        private const val WRAP_NONE = 0
+        private const val WRAP_FREEZE = 1
+        private const val WRAP_LIFTED = 2
+        private const val WRAP_FREEZE_MS = 34L
+        private const val WRAP_LIFT_MS = 17L
+        private const val MIN_STILL_MS = 60L
+
+        private val GOLD = Color.rgb(233, 196, 106)
+        private val IVORY = Color.rgb(255, 247, 224)
+        private val NAVY = Color.argb(170, 22, 40, 98)
+        private val NAVY_SOFT = Color.argb(70, 22, 40, 98)
+        private val SKY = Color.argb(210, 70, 130, 235)
+        private val SKY_LIGHT = Color.rgb(140, 200, 255)
+
+        const val PREF_ENABLED = "kiu_enabled"
+        const val PREF_FIRE_TOGGLE = "kiu_fire_toggle"
+        const val PREF_EDGE_WRAP = "kiu_edge_wrap"
+        const val PREF_SHOW_AB = "kiu_show_ab"
+        const val PREF_HAPTICS = "kiu_haptics"
+        const val PREF_STICK_ALPHA = "kiu_stick_alpha"
+        const val PREF_BUTTON_ALPHA = "kiu_button_alpha"
+        const val PREF_CAM_SENS = "kiu_cam_sens"
+        const val PREF_CAM_ACCEL = "kiu_cam_accel"
+        const val PREF_HOLD_AIM = "kiu_hold_aim"
+        const val PREF_BTN_PREFIX = "kiu_btn_"
+    }
+}
